                    "ruleType": "addback_then_subtract_spread",
                    "parametersByYear": [
                        {
                            "effectiveFromTaxYear": 2023,
                            "effectiveToTaxYear": 2026,
                            "parameters": {
                                "addbackBase": "federalBonus168k",
                                "spreadMethod": "straight_line",
