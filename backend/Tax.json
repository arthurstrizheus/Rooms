{
    "rulePackMeta": {
        "name": "SEA_Limited_State_Depreciation_Rules",
        "version": "2026-01-29",
        "notes": "State-specific depreciation adjustments for business income/franchise tax computations. URLs are official state government sources.",
        "defaultAssumption": "Compute Federal depreciation first (MACRS/179/168k), then apply state modifications from this pack."
    },
    "taxTypes": [
        {
            "taxTypeId": "FEDERAL_INCOME",
            "label": "Federal Income Tax (baseline)",
            "depreciationTreatment": { "ruleType": "use_federal_as_is" }
        },
        {
            "taxTypeId": "STATE_BUSINESS_INCOME_OR_FRANCHISE",
            "label": "State business income / franchise tax base",
            "depreciationTreatment": { "ruleType": "use_state_rules_by_office" }
        }
    ],
    "offices": [
        {
            "officeid": 1,
            "alias": "Columbus",
            "state": "OH",
            "city": "Columbus",
            "tax": {
                "STATE_BUSINESS_INCOME_OR_FRANCHISE": {
                    "ruleType": "addback_bonus_plus_179_over_threshold",
                    "parametersByYear": [
                        {
                            "effectiveFromTaxYear": 2018,
                            "effectiveToTaxYear": null,
                            "parameters": {
                                "section179Threshold": 25000,
                                "addbackFormula": "stateAddback = federalBonus168k + max(0, federalSection179 - 25000)",
                                "notes": "Ohio add-back uses total Section 179 expense less $25,000 plus all Section 168(k) bonus depreciation."
                            },
                            "sources": [
                                "https://tax.ohio.gov/faq-IncomeDepreciation",
                                "https://tax.ohio.gov/business/pass-through-entity-and-fiduciary-income-tax"
                            ]
                        }
                    ]
                }
            }
        },

